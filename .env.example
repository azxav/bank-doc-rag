# Copy to .env for a live OpenRouter run. Never commit .env.
# Leave the key empty and use `make demo-offline` when you have no credits.
# OFFLINE_DEMO=true serves /ask from an in-memory hash index and quoted citations.
OPENROUTER_API_KEY=
OFFLINE_DEMO=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chat model. If OpenRouter returns 404 for this id, the client falls back
# to the closest available Luna chat model and logs the id it used.
CHAT_MODEL=openai/gpt-6-luna
EMBEDDING_MODEL=openai/text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bank_docs
# Set QDRANT_LOCATION=:memory: or QDRANT_PATH=./.qdrant to skip the server.
QDRANT_LOCATION=
QDRANT_PATH=

APP_ENV=development
JWT_SECRET_KEY=local-demo-jwt-secret-not-for-production-00
JWT_EXPIRE_DAYS=7
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-not-a-bank
AUTH_REQUIRED=false

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

RETRIEVAL_TOP_K=8
